{
  "name": "neorest-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "REST APIs with WebSockets. Do regular REST operations (GET, POST, DELETE) on routes, and subscribe to them.",
  "author": "Dmitry Kury (https://dkury.com)",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "clean": "npm run clean --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "build:packages": "npm run build --workspace @neorest/core && npm run build --workspace @neorest/router-core && npm run build --workspace neorest",
    "test:node": "npm run test --workspace @neorest/tests-node",
    "test:core:integration": "cd tests/deno-core && deno test --allow-net --import-map=import_map.json client_server_test.ts",
    "test:all": "npm run test:core:integration"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitkury/neorest.git"
  },
  "homepage": "https://github.com/mitkury/neorest",
  "keywords": [
    "REST",
    "WebSockets",
    "API",
    "Real-time",
    "Subscriptions"
  ],
  "devDependencies": {
    "rimraf": "^5.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.0.0"
  }
}
