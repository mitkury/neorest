{
  "name": "@neorest/benchmark",
  "version": "1.0.0",
  "description": "Performance benchmarking and stress testing for Neorest",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "bench": "npm run build && npm start",
    "stress": "npm run build && node dist/stress-test.js",
    "memory": "npm run build && node dist/memory-test.js",
    "concurrent": "npm run build && node dist/concurrent-test.js"
  },
  "dependencies": {
    "neorest": "workspace:*",
    "neorest/node": "workspace:*",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "node-memwatch": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0"
  }
}