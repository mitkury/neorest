{
  "name": "@neorest/examples-rooms",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "rooms-api",
    "rooms-web"
  ],
  "scripts": {
    "postinstall": "npm install --workspace=@neorest/rooms-api && npm install --workspace=@neorest/rooms-web",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev --workspace=@neorest/rooms-api\" \"npm:dev --workspace=@neorest/rooms-web\"",
    "build": "npm run build --workspace=@neorest/rooms-api && npm run build --workspace=@neorest/rooms-web",
    "start": "concurrently -n api,web -c blue,magenta \"npm:start --workspace=@neorest/rooms-api\" \"npm:preview --workspace=@neorest/rooms-web\""
  },
  "overrides": {
    "@neorest/core": "file:../../core",
    "@neorest/router-core": "file:../../router-core"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}