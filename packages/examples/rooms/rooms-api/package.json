{
  "name": "@neorest/rooms-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsup src/index.ts --watch --format esm,cjs --onSuccess \"node dist/index.js\"",
    "start": "node dist/index.js",
    "build": "rimraf dist && tsup src/index.ts --format esm,cjs",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@neorest/router-node": "^0.1.0"
  },
  "overrides": {
    "@neorest/core": "file:../../../core",
    "@neorest/router-core": "file:../../../router-core",
    "@neorest/router-node": "file:../../../router-node"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.5.4",
    "rimraf": "^5.0.10"
  }
}