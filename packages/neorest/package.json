{
  "name": "neorest",
  "version": "0.1.0",
  "description": "REST APIs with WebSockets. Do regular REST operations (GET, POST, DELETE) on routes, and subscribe to them",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/index.browser.js",
      "deno": "./deno/mod.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "import": "./dist/node.mjs",
      "require": "./dist/node.cjs"
    },
    "./browser": "./dist/index.browser.js",
    "./deno": "./deno/mod.js",
    "./core": {
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs"
    }
  },
  "browser": {
    "./dist/node.mjs": false,
    "./dist/node.cjs": false,
    "ws": false,
    "fs": false,
    "path": false,
    "crypto": false
  },
  "scripts": {
    "prebuild": "rimraf dist deno",
    "build": "tsup",
    "clean": "rimraf dist deno"
  },
  "author": "Dmitry Kury (https://dkury.com)",
  "license": "MIT",
  "files": [
    "dist",
    "deno"
  ],
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "rimraf": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "tsup": "^8.4.0"
  },
  "keywords": [
    "REST",
    "WebSockets",
    "API",
    "Real-time",
    "Subscriptions"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mitkury/neorest.git"
  },
  "homepage": "https://github.com/mitkury/neorest"
}