{
  "name": "neorest",
  "version": "0.1.0",
  "description": "REST-shaped realtime APIs over WebTransport, WebSocket, and HTTP fallback",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.cjs"
    },
    "./browser": "./dist/index.browser.js",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs"
    }
  },
  "browser": {
    "./dist/node.mjs": false,
    "./dist/node.cjs": false,
    "ws": false,
    "fs": false,
    "path": false,
    "crypto": false
  },
  "scripts": {
    "prebuild": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly --outDir dist",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "author": "Dmitry Kury (https://dkury.com)",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "dependencies": {
    "ws": "^8.21.1"
  },
  "peerDependencies": {
    "@fails-components/webtransport": "^1.6.7",
    "@fails-components/webtransport-transport-http3-quiche": "^1.6.7"
  },
  "peerDependenciesMeta": {
    "@fails-components/webtransport": {
      "optional": true
    },
    "@fails-components/webtransport-transport-http3-quiche": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fails-components/webtransport": "^1.6.7",
    "@fails-components/webtransport-transport-http3-quiche": "^1.6.7",
    "typescript": "^5.0.0",
    "rimraf": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10"
  },
  "keywords": [
    "REST",
    "WebSockets",
    "WebTransport",
    "API",
    "Real-time",
    "Subscriptions"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mitkury/neorest.git"
  },
  "homepage": "https://github.com/mitkury/neorest"
}
