{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "neorest": ["../../neorest/src/index"],
      "neorest/*": ["../../neorest/src/*"],
      "neorest/node": ["../../neorest/src/node/index"],
      "neorest/core": ["../../neorest/src/core/index"]
    }
  },
  "include": [
    "*.ts",
    "../../neorest/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
