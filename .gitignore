# Dependency directories
node_modules/
.npm/

# Build outputs
dist/
build/
*.tsbuildinfo
*.tgz
tmp/

# Prevent committing generated artifacts inside src
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.map

# Hand-authored declarations for optional runtime dependencies.
!packages/neorest/src/optional-webtransport.d.ts

# Debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor configs
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Legacy code
old_src/
*.log

# Generated live-media benchmark artifacts
packages/benchmark/artifacts/
